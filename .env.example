# ===================================================
# DOCKER & DATABASE ENVIRONMENT CONFIGURATION
# ===================================================
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=your_secure_postgres_password

# ===================================================
# STRAPI SECURITY SECRETS
# (Generate random string or use strapi default values)
# ===================================================
APP_KEYS=generate_random_key_1,generate_random_key_2
API_TOKEN_SALT=generate_random_api_salt
ADMIN_JWT_SECRET=generate_random_admin_jwt_secret
TRANSFER_TOKEN_SALT=generate_random_transfer_salt
JWT_SECRET=generate_random_jwt_secret
ENCRYPTION_KEY=generate_random_encryption_key

# ===================================================
# PUBLIC URLs (CLOUDFLARE TUNNEL DOMAINS)
# ===================================================
NEXT_PUBLIC_STRAPI_API_URL=https://cms.yourdomain.com
